# App Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://thikana:thikana_secret@localhost:5432/thikana_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=thikana-vault

# JWT Auth
JWT_ACCESS_SECRET=thikana_super_secret_access_jwt_key_change_in_production_32chars
JWT_REFRESH_SECRET=thikana_super_secret_refresh_jwt_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Routing & Isochrones
OPENROUTESERVICE_API_KEY="" # Paste your free ORS API key here, or leave blank to use the offline calibrated Hyderabad traffic model
