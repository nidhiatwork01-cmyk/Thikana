# App Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS on port 5433)
POSTGRES_PORT=5433
POSTGRES_USER=thikana
POSTGRES_PASSWORD=thikana_secret
POSTGRES_DB=thikana_db
DATABASE_URL=postgresql://thikana:thikana_secret@localhost:5433/thikana_db?schema=public

# Redis on port 6380
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# S3 / MinIO Object Storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=thikana-vault

# JWT Auth
JWT_ACCESS_SECRET=thikana_super_secret_access_jwt_key_change_in_production_32chars
JWT_REFRESH_SECRET=thikana_super_secret_refresh_jwt_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Routing & Isochrones (OpenRouteService)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
